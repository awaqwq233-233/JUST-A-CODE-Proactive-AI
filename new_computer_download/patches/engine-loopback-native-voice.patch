+// Apply the requested TTS voice before duplex threads start; never fall back.
+static bool jac_apply_voice_condition(omni_context * octx, const ParsedSessionInit & init,
+                                      const std::string & temp_dir, json & metadata) {
+    if (!init.use_tts) return true;
+    if (!octx->token2wav_initialized || !octx->token2wav_session) return false;
+    // Clear all per-session token buffers before selecting a voice, including the default.
+    octx->token2wav_buffer = {4218, 4218, 4218};
+    octx->token2wav_wav_idx = 0;
+    if (init.tts_ref_audio_b64.empty()) {
+        octx->token2wav_session->reset();
+        bool ok = octx->token2wav_session->t2w.start_stream_with_prompt_cache_gguf(
+            octx->token2wav_model_dir + "/prompt_cache.gguf", 5, 1.0f);
+        metadata = {{"applied", false}, {"source", "official_default"}};
+        LOG_INF("JAC native voice selected: official_default\n");
+        return ok;
+    }
+    const char * python = std::getenv("JAC_VOICE_PYTHON");
+    const char * script = std::getenv("JAC_VOICE_PREPARE_SCRIPT");
+    const char * models = std::getenv("JAC_VOICE_MODEL_DIR");
+    const char * cache = std::getenv("JAC_VOICE_CACHE_DIR");
+    if (!python || !script || !models || !cache || !octx->token2wav_initialized || !octx->token2wav_session) {
+        LOG_ERR("JAC native voice frontend is not configured; use the pinned J.A.C. launcher\n");
+        return false;
+    }
+    std::string wav = TempMediaFiles::write_audio_wav(init.tts_ref_audio_b64, temp_dir, -1);
+    if (wav.empty()) return false;
+    std::string result_file = wav + ".voice.json";
+    bool ok = false;
+    try {
+        if (!jac_run_voice_frontend({python, script, "--audio", wav, "--model-dir", models,
+                                    "--cache-dir", cache, "--result-file", result_file})) {
+            throw std::runtime_error("local frontend failed or timed out");
+        }
+        std::ifstream stream(result_file);
+        json prepared = json::parse(stream);
+        std::string hash = prepared.at("voice_sha256").get<std::string>();
+        fs::path bundle_dir = fs::canonical(prepared.at("bundle_dir").get<std::string>());
+        if (hash.size() != 64 || hash.find_first_not_of("0123456789abcdef") != std::string::npos ||
+            bundle_dir.parent_path() != fs::canonical(cache) || bundle_dir.filename() != "v1-" + hash) {
+            throw std::runtime_error("voice cache identity mismatch");
+        }
+        omni::flow::Token2Mel::PromptBundle bundle;
+        if (!omni::flow::Token2Mel::load_prompt_bundle_dir(bundle_dir.string(), bundle)) {
+            throw std::runtime_error("voice bundle could not be loaded");
+        }
+        octx->token2wav_session->reset();
+        if (!octx->token2wav_session->t2w.start_stream_with_prompt(bundle, 5, 1.0f)) {
+            throw std::runtime_error("Token2Wav voice setup failed");
+        }
+        metadata = {{"applied", true}, {"reference_sha256", hash},
+                    {"cache_hit", prepared.at("cache_hit")}};
+        LOG_INF("JAC native voice applied: sha256=%s cache_hit=%d tokens=%lld\n", hash.c_str(),
+                prepared.at("cache_hit").get<bool>(), (long long) bundle.T_prompt_token - 3);
+        ok = true;
+    } catch (const std::exception & error) {
+        LOG_ERR("JAC native voice setup failed: %s\n", error.what());
+    }
+    fs::remove(wav);
+    fs::remove(result_file);
+    return ok;
+}
