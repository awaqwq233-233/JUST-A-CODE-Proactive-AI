+
+// Prepare literal tokens outside the sampling loop; input text cannot insert control tokens.
+bool omni_prepare_task_speech(omni_context * ctx, const std::string & id, const std::string & text) {
+    if (!ctx) return false;
+    std::lock_guard<std::mutex> guard(ctx->jac_speech_state_mutex);
+    if (!ctx->duplex_mode || !ctx->async || !ctx->use_tts || ctx->jac_speech_busy.load()
+        || text.empty() || text.size() > 768 || id.empty() || id.size() > 80
+        || ctx->special_token_speak < 0 || ctx->special_token_turn_eos < 0 || ctx->special_token_chunk_eos < 0) return false;
+    auto tokens = common_tokenize(ctx->ctx_llama, text, false, false);
+    if (tokens.empty() || tokens.size() > 192) return false;
+    for (auto token : tokens) if (!is_valid_tts_token(token)) return false;
+    tokens.insert(tokens.begin(), ctx->special_token_speak);
+    tokens.push_back(ctx->special_token_turn_eos);
+    tokens.push_back(ctx->special_token_chunk_eos);
+    ctx->jac_speech_tokens = std::move(tokens);
+    ctx->jac_speech_position = 0;
+    ctx->jac_speech_id = id;
+    ctx->jac_speech_busy.store(true);
+    return true;
+}
